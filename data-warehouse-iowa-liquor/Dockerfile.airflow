FROM apache/airflow:2.9.3-python3.11

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg unixodbc-dev \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list \
        > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -f /opt/microsoft/msodbcsql18/lib64/libmsodbcsql-18.6.so.2.1 \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends --reinstall msodbcsql18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=airflow:0 requirements.txt /tmp/requirements.txt

USER airflow

RUN grep -viE '^\s*(apache-airflow([=<>~! ].*)?|#.*)?\s*$' /tmp/requirements.txt > /tmp/requirements-airflow-safe.txt \
    && pip install --no-cache-dir \
        --constraint https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.11.txt \
        -r /tmp/requirements-airflow-safe.txt
